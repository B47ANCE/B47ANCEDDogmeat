  "findings": [
    {
      "id": "B01",
      "classification": "NATIVE_OBSERVATION_LUA_ROUTE_UNVERIFIED",
      "class": "zombie.network.GameServer",
      "methods": [
        "getConnectionFromPlayer(IsoPlayer)",
        "getConnectionByPlayerOnlineID(short)"
      ],
      "offsets": "getConnectionFromPlayer: 0-4 PlayerToAddressMap lookup, 12-16 nil guard, 17-27 active-connection lookup/return",
      "observation": "Native player-object map can find a connection without reading a chosen username. GameServer has no literal setExposed registration in the inspected exposer; no approved Lua global route was established."
    },
    {
      "id": "B02",
      "classification": "NATIVE_OBSERVATION_LUA_ROUTE_UNVERIFIED",
      "class": "zombie.chat.ChatUtility",
      "methods": [
        "findConnection(short)",
        "findConnection(String)"
      ],
      "offsets": "short overload: 2-37 server engine connection enumeration, 44-67 slot playerIds match; String overload: 68-85 player.username comparison",
      "observation": "Native chat helper has a connection route, but no literal setExposed registration or vanilla Lua receiver is established. Username overload matches player slot text rather than authenticating the root account."
    },
    {
      "id": "B03",
      "classification": "NATIVE_OBSERVATION_NOT_ACCOUNT_BINDING",
      "class": "zombie.characters.IsoGameCharacter",
      "methods": [
        "getOwner()",
        "IsoZombie.getOwner()",
        "IsoZombie.getOwnerPlayer()"
      ],
      "offsets": "IsoGameCharacter.getOwner: 0-1 nil return; IsoZombie.getOwner: 0-25 NetworkZombieComponent optional owner",
      "observation": "Player base getter returns nil; IsoPlayer and IsoAnimal have no inspected override. Zombie ownership can return a simulator connection, but depends on a separate zombie/component and does not certify the callback actor or universal availability. No world scan or simulation-owner change was added."
    },
    {
      "id": "B04",
      "classification": "NATIVE_OBSERVATION_CLIENT_STATE_NOT_SERVER_ROSTER",
      "class": "zombie.network.GameClient",
      "methods": [
        "startClient()",
        "GlobalObject.getGameClient()",
        "GlobalObject.getClientUsername()",
        "GlobalObject.getOnlineUsername()"
      ],
      "offsets": "startClient: 28-49 constructs its client UdpEngine; GlobalObject.getClientUsername: 0-13 client flag gate; getOnlineUsername: 0-6 local player display name",
      "observation": "Client singleton, its static connection and instance engine are not the dedicated server actor connection map. No client account label or display name is adopted."
    },
    {
      "id": "B05",
      "classification": "BOUNDED_DESCRIPTOR_INVENTORY",
      "class": "packaged zombie public descriptors",
      "observation": "20 direct public return/field descriptors for UdpConnection, IConnection, GameServer or UdpEngine were inventoried. No direct IConnection or GameServer return/field was found. Other UdpConnection receivers include simulation ownership, internal jobs, client state and server internals. This excludes collection generic contents, private/object graph/reflection paths and is not a universal impossibility proof."
    },
    {
      "id": "B06",
      "classification": "NATIVE_OBSERVATION_CURRENT_ACTOR_ONLY",
      "class": "zombie.Lua.LuaManager$GlobalObject",
      "methods": [
        "getPlayerByOnlineID(int)",
        "UdpConnection.getPlayerAt(int)",
        "UdpConnection.getUserName()"
      ],
      "offsets": "getPlayerByOnlineID: 0-20 server IDToPlayerMap; getPlayerAt: 0-6 players array; no-arg getUserName: 0-4 root userName field",
      "observation": "Exact current player-reference and slot checks can reject stale/wrong actors in an experiment. They do not authenticate an account incarnation, expose a missing connection, or establish restart continuity."
    },
    {
      "id": "B07",
      "classification": "NATIVE_OBSERVATION_NOT_ACCOUNT_FEED",
      "class": "zombie.network.statistics.StatusManager",
      "methods": [
        "getTable()",
        "Statistic.getLocalTable()",
        "Statistic.getRemoteTable()"
      ],
      "offsets": "StatusManager.getTable: 0-11 wipe then GameClient.client guard; Statistic getters: 0-7 stored table return",
      "observation": "Client status and local/remote statistics tables are not a verified server player-to-authenticated-account registry. No table value is promoted to identity proof."
    },
    {
      "id": "B08",
      "classification": "INFERRED_LIFECYCLE_BLOCKER_RETAINED",
      "class": "prior account evidence A07-A10",
      "observation": "Even an observed root-account association is insufficient for automatic rename/delete/recreation/rollback continuity. Equal text after account recreation cannot distinguish a retained account from a new incarnation without an authenticated lifecycle feed or explicitly reviewed operator process."
    }
  ],
