  "runtime_cases": [
    {
      "id": "AC01",
      "scenario": "Normal account login",
      "required": "Valid credentials select current primary account; invalid credentials cause no mod identity or disclosure.",
      "status": "NOT TESTED"
    },
    {
      "id": "AC02",
      "scenario": "Two simultaneous accounts and forged args",
      "required": "Each callback remains its authenticated principal; supplied account/owner/role fields cannot choose another principal.",
      "status": "NOT TESTED"
    },
    {
      "id": "AC03",
      "scenario": "Reconnect with same character",
      "required": "Same durable principal after fresh account proof; new connection/session fence, retained dog history.",
      "status": "NOT TESTED"
    },
    {
      "id": "AC04",
      "scenario": "Character death and replacement",
      "required": "New character episode cannot restore old lease; account continuity only with valid current root-account binding.",
      "status": "NOT TESTED"
    },
    {
      "id": "AC05",
      "scenario": "Secondary/co-op alias collision",
      "required": "An authenticated connection claiming an offline existing account name as slot alias cannot access that account principal.",
      "status": "NOT TESTED"
    },
    {
      "id": "AC06",
      "scenario": "Slot-zero replacement with AllowCoop false",
      "required": "Do not treat playerNum zero as sufficient; verify root account association before any principal use.",
      "status": "NOT TESTED"
    },
    {
      "id": "AC07",
      "scenario": "Case variants and Unicode",
      "required": "One native account does not split into duplicate principals; unrelated accounts do not merge under guessed normalization.",
      "status": "NOT TESTED"
    },
    {
      "id": "AC08",
      "scenario": "Administrator rename",
      "required": "Reviewed alias migration preserves principal once, invalidates stale contexts and leaves old label unavailable for implicit reuse.",
      "status": "NOT TESTED"
    },
    {
      "id": "AC09",
      "scenario": "Delete and recreate same account name",
      "required": "New credentials/incarnation never inherit old principal/dogs through name equality; preserve original records.",
      "status": "NOT TESTED"
    },
    {
      "id": "AC10",
      "scenario": "Password/auth-mode reset and account policy",
      "required": "Verify protected accounts, configured auth method/second factor, Open enrollment and death-removal behavior; no credential copy into mod.",
      "status": "NOT TESTED"
    },
    {
      "id": "AC11",
      "scenario": "Full restart and account/private backup rollback",
      "required": "Recover exact retained registry/world pair; reauthenticate; old leases invalid; coordinated rollback freshness limits explicit.",
      "status": "NOT TESTED"
    },
    {
      "id": "AC12",
      "scenario": "Missing or conflicting roster/realm/actor",
      "required": "Refuse automatic initialization, cross-realm linking or first-match adoption; preserve private state and unrelated clients.",
      "status": "NOT TESTED"
    }
